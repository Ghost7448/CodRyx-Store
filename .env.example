NODE_ENV=production
PORT=3000

# Railway MySQL: use MYSQL_URL or the MYSQL_* fields below.
MYSQL_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=10

# Paymob credentials will be added after confirming the merchant's enabled API flow.
# Never put real credentials in this file or in Git.

# One-time first-owner setup. Generate at least 32 random characters.
OWNER_SETUP_SECRET=
